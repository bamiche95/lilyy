# ─── Database (Neon) ──────────────────────────────────────────────────────────
# Pooled connection for the app, direct connection for migrations.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# ─── Better Auth ──────────────────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
# MUST be the public origin in production (e.g. https://www.example.com), with no
# trailing slash. A localhost value there makes Better Auth reject every
# cookie-bearing POST to /api/auth/* with 403 INVALID_ORIGIN — the origin list in
# lib/auth.ts is derived from these two values.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# Authorised redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Seeded admin account (npm run db:seed)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ─── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="Lilyy Bakers"
IMAP_HOST=""
IMAP_PORT="993"
IMAP_USER=""
IMAP_PASSWORD=""
ORDERS_EMAIL="orders@lilyybakers.com"
SUPPORT_EMAIL="contact@lilyybakers.com"

# ─── Cloudflare R2 ────────────────────────────────────────────────────────────
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="lilyybakers-products"

# ─── i18n / currency ──────────────────────────────────────────────────────────
DEFAULT_LOCALE="en"
# Value of 1 NOK in each currency
CURRENCY_RATES='{"NOK":1,"USD":0.094,"EUR":0.086,"GBP":0.074}'

# ─── Stripe (Phase 4) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
