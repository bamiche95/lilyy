{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:status": "dotenv -e .env.local -- prisma migrate status",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "auth:generate": "dotenv -e .env.local -- npx --yes auth@1.7.25 generate --config lib/auth.ts --output prisma/schema.prisma --adapter prisma --dialect postgresql --yes",
    "icons": "node scripts/generate-icons.mjs",
    "check:cart": "tsx scripts/check-cart.ts",
    "check:orders": "tsx scripts/check-orders.ts",
    "gate": "dotenv -e .env.local -- node scripts/gate-auth.mjs",
    "gate:shop": "dotenv -e .env.local -- node scripts/gate-shop.mjs",
    "gate:orders": "dotenv -e .env.local -- node scripts/gate-orders.mjs"
  },
  "prisma": {
    "seed": "dotenv -e .env.local -- tsx prisma/seed.ts"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "effect": "3.22.1",
    "source-map-js": "1.2.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@aws-sdk/s3-request-presigner": "^3.1170.0",
    "@neon/config": "^1.14.2",
    "@neon/env": "^2.1.5",
    "@prisma/client": "^6.19.3",
    "better-auth": "^1.7.25",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "nodemailer": "^10.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
